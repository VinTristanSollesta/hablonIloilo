<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".ui.color.CompareColorsFragment">

    <TextView
        android:id="@+id/compare_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Color Comparison"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textAlignment="center"
        android:padding="16dp"
        android:background="@android:color/white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/captured_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/compare_title"
        app:layout_constraintBottom_toTopOf="@id/save_palette_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/divider"
        app:layout_constraintHorizontal_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/captured_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📸 Captured Colors"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="?attr/colorPrimary"
                android:textColor="@android:color/white"
                android:gravity="center" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/captured_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <View
        android:id="@+id/divider"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/compare_title"
        app:layout_constraintBottom_toTopOf="@id/save_palette_button"
        app:layout_constraintStart_toEndOf="@id/captured_card"
        app:layout_constraintEnd_toStartOf="@id/existing_card" />

    <androidx.cardview.widget.CardView
        android:id="@+id/existing_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/compare_title"
        app:layout_constraintBottom_toTopOf="@id/save_palette_button"
        app:layout_constraintStart_toEndOf="@id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/existing_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎨 Existing Palettes"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="@color/purple_500"
                android:textColor="@android:color/white"
                android:gravity="center" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/existing_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:clipToPadding="false" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_palette_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="💾 Save as New Palette"
        android:textSize="16sp"
        android:layout_margin="16dp"
        android:padding="16dp"
        app:cornerRadius="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

